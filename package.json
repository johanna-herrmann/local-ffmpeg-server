{
  "name": "local-ffmpeg-server",
  "version": "0.0.1",
  "description": "Locally running server to run ffmpeg commands local instead of in-browser.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "local-ffmpeg-server": "lib/index.js"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --verbose --detectOpenHandles --forceExit",
    "audit": "better-npm-audit audit",
    "lint": "eslint lib/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/johanna-herrmann/local-ffmpeg-server.git"
  },
  "keywords": [
    "ffmpeg",
    "server",
    "engine",
    "ffprobe"
  ],
  "author": "Johanna Herrmann",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johanna-herrmann/local-ffmpeg-server/issues"
  },
  "homepage": "https://github.com/johanna-herrmann/local-ffmpeg-server#readme",
  "dependencies": {
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@radically-straightforward/package": "^2.0.3",
    "better-npm-audit": "^3.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "serve": "^14.2.5",
    "supertest": "^7.1.4"
  }
}
